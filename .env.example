# Скопируй в .env.local для локальной разработки.
# На Vercel задавай эти переменные через Settings -> Environment Variables.

# Базовый URL сайта (используется в metadataBase, sitemap, canonical, JSON-LD).
# Локально: http://localhost:3000
# На превью Vercel выставляется автоматически (см. инструкцию по деплою).
# На проде: https://<твой-домен>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Базовый URL API (на текущем этапе это сам сайт + /api).
# Локально: http://localhost:3000/api
# На проде: https://<твой-домен>/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
